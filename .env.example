# PolicyGuard AI — Environment Configuration
# Copy this to .env and fill in values before starting.

# ── LLM Configuration ──────────────────────────────────────
# Model to use for agent reasoning. Options:
#   qwen2.5:7b  — best tool-use accuracy (recommended, ~5GB RAM)
#   llama3.2:3b — fastest on CPU-only hardware (~2GB RAM)
#   mistral:7b  — good general reasoning (~5GB RAM)
OLLAMA_MODEL=qwen2.5:7b

# ── Security ────────────────────────────────────────────────
# Change this to a random secret in production!
SECRET_KEY=change-me-to-a-random-secret-key-in-production

# ── Optional: Air-gap mode ──────────────────────────────────
# Set to "true" to enable strict logging for offline audits
AIRGAP_MODE=false

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
